# MONGODB_URI: Required for MongoDB Atlas persistent storage. Leave empty to fallback to secure persistent JSON file storage.
MONGODB_URI=

# JWT Secrets for token signing and validation
JWT_SECRET=
JWT_REFRESH_SECRET=

# Resend Email Configuration for automated notifications
RESEND_API_KEY=
RESEND_FROM=

# Cloudinary Storage Configuration for assignment drafts and transaction screenshots
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dynamic Application Callback Links
NEXT_PUBLIC_APP_URL=
APP_URL=
